{
  "name": "@biblioteca/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch --import=tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../.env dist/index.js"
  },
  "dependencies": {
    "@biblioteca/shared": "0.0.0",
    "better-sqlite3": "13.2.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "4.23.15"
  }
}
