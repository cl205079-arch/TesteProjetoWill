{
  "name": "biblioteca-comunitaria",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["shared", "server", "app"],
  "engines": { "node": ">=24 <25", "npm": ">=11" },
  "scripts": {
    "dev": "concurrently -k -n shared,server,app \"npm run dev -w @biblioteca/shared\" \"npm run dev:server\" \"npm run dev:app\"",
    "dev:app": "npm run dev -w @biblioteca/app",
    "dev:server": "npm run dev -w @biblioteca/server",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run typecheck && npm run build --workspaces",
    "start:app": "npm run start -w @biblioteca/app",
    "start:server": "npm run start -w @biblioteca/server"
  },
  "devDependencies": {
    "concurrently": "10.0.7",
    "typescript": "7.0.2"
  }
}
