{
  "name": "biblioteca-comunitaria",
  "version": "0.1.0",
  "private": true,
  "description": "Projeto Final de DAD - Biblioteca Comunitaria",
  "workspaces": [
    "app",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,app -c blue,yellow \"npm:dev:server\" \"npm:dev:app\"",
    "dev:server": "npm run dev -w @biblioteca/server",
    "dev:app": "npm run dev -w @biblioteca/app",
    "build": "npm run build -w @biblioteca/shared && npm run build -w @biblioteca/server && npm run build -w @biblioteca/app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run start -w @biblioteca/server"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
