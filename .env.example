# Copie este arquivo para .env e ajuste apenas no seu computador.
# Nunca commite .env nem valores reais de credenciais.

# Ambiente
NODE_ENV=development

# Servidor Express
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Banco previsto para as proximas etapas (SQLite com better-sqlite3).
# Nao criar tabelas ou migrations nesta base.
DATABASE_PATH=./data/biblioteca.sqlite

# Electron: origem da API propria. Nunca embutir segredos aqui.
VITE_API_URL=http://localhost:3000/api

# Integracoes futuras: preencher somente em ambiente local, se necessario.
GOOGLE_BOOKS_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
WHATSAPP_TOKEN=
